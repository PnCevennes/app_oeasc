[Unit]
Description=OEASC
After=postgresql.service
After=network.target

[Service]
Type=simple
User=${USER_SERVICE}
Group=${USER_SERVICE}
WorkingDirectory=${BASE_DIR}/backend
# même fichier de configuration que celui utilisé pour le build du frontend
Environment="OEASC_CONFIG=${OEASC_CONFIG_FILE}"
Environment=GUNICORN_PROC_NAME=oeasc
Environment=GUNICORN_NUM_WORKERS=${GUN_NUM_WORKERS}
Environment=GUNICORN_HOST=${GUN_HOST}
Environment=GUNICORN_PORT=${GUN_PORT}
Environment=GUNICORN_TIMEOUT=${GUN_TIMEOUT}
Environment=GUNICORN_LOG_FILE=/var/log/oeasc/%N%I.log
EnvironmentFile=-${BASE_DIR}/environ
ExecStart=${BASE_DIR}/venv/bin/gunicorn app:app \
                --name "${GUNICORN_PROC_NAME}" --workers "${GUNICORN_NUM_WORKERS}" \
                --bind "${GUNICORN_HOST}:${GUNICORN_PORT}" --timeout="${GUNICORN_TIMEOUT}" \
                --log-file "${GUNICORN_LOG_FILE}"
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStartSec=10
TimeoutStopSec=5
PrivateTmp=true

[Install]
WantedBy=multi-user.target
